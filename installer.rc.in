#include <windows.h>

1 VERSIONINFO
FILEVERSION     @SINE_VERSION_MAJOR@,@SINE_VERSION_MINOR@,@SINE_VERSION_PATCH@,0
PRODUCTVERSION  @SINE_VERSION_MAJOR@,@SINE_VERSION_MINOR@,@SINE_VERSION_PATCH@,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName",      "SineOrg\0"
      VALUE "FileDescription",  "Sine Installer\0"
      VALUE "FileVersion",      "@SINE_VERSION@\0"
      VALUE "InternalName",     "sine_installer\0"
      VALUE "LegalCopyright",   "Copyright (c) 2026 CosmoCreeper\0"
      VALUE "OriginalFilename", "@SINE_OUTPUT_NAME@.exe\0"
      VALUE "ProductName",      "Sine\0"
      VALUE "ProductVersion",   "@SINE_VERSION@\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END

1 RT_MANIFEST "@CMAKE_CURRENT_SOURCE_DIR@/app.manifest"
